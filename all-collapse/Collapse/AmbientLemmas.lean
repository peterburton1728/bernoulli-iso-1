module

public import Collapse.Tower

/-!
# Two facts about the group `N × (ℤ/2 ≀ ℤ)`

Used for the freeness and ergodicity of generalized Bernoulli shifts (`Collapse.GBLemmas`), with `F` the subgroup generated by
the lamp at site `0`, which is `H 1` of the tower: every `g ≠ 1` moves infinitely many cosets
of `F`, and the orbits of `NP` on the cosets of `F` are infinite.
-/

@[expose] public section

set_option linter.unusedSectionVars false

noncomputable section

namespace Collapse

section Ambient

open BernoulliIso

variable (N : Type) [Group N]

theorem ambient_H_one_card : Nat.card ((ambientTower N).H 1) = 2 := by
  simpa using (ambientTower N).H_card 1

/-- The shift by `n` in `G`. -/
def ambShift (n : ℤ) : Ambient.G N := (1, SemidirectProduct.inr (Multiplicative.ofAdd n))

theorem ambient_mem_F {y : Ambient.G N} (hy : y ∈ (ambientTower N).H 1) :
    y.1 = 1 ∧ y.2.right = 1 ∧ ∀ i, i ∉ Ambient.sites 1 → y.2.left.toAdd i = 0 := by
  obtain ⟨a, ha, rfl⟩ := hy
  exact ⟨rfl, rfl, ha⟩

theorem ambShift_conj_fst (g : Ambient.G N) (n : ℤ) :
    ((ambShift N n)⁻¹ * g * ambShift N n).1 = g.1 := by
  simp [ambShift]

theorem ambShift_conj_right (g : Ambient.G N) (n : ℤ) :
    ((ambShift N n)⁻¹ * g * ambShift N n).2.right = g.2.right := by
  simp [ambShift, SemidirectProduct.mul_right, SemidirectProduct.inv_right]

theorem ambShift_conj_left (g : Ambient.G N) (n : ℤ) (i : ℤ) :
    ((ambShift N n)⁻¹ * g * ambShift N n).2.left.toAdd i = g.2.left.toAdd (n + i) := by
  simp only [ambShift, Prod.snd_mul, Prod.snd_inv, SemidirectProduct.mul_left,
    SemidirectProduct.inv_left, SemidirectProduct.mul_right, SemidirectProduct.inv_right,
    SemidirectProduct.left_inr, SemidirectProduct.right_inr, map_one, inv_one, one_mul, mul_one]
  simp [Ambient.shiftAction]

theorem ambient_conj_unique (g : Ambient.G N) (hg : g ≠ 1) {n m : ℤ}
    (hn : (ambShift N n)⁻¹ * g * ambShift N n ∈ (ambientTower N).H 1)
    (hm : (ambShift N m)⁻¹ * g * ambShift N m ∈ (ambientTower N).H 1) : n = m := by
  obtain ⟨h1, h2, h3⟩ := ambient_mem_F N hn
  obtain ⟨-, -, h3'⟩ := ambient_mem_F N hm
  rw [ambShift_conj_fst] at h1
  rw [ambShift_conj_right] at h2
  have hl : g.2.left ≠ 1 := by
    intro hl
    exact hg (Prod.ext h1 (SemidirectProduct.ext hl h2))
  obtain ⟨j, hj⟩ : ∃ j, g.2.left.toAdd j ≠ 0 := by
    by_contra hc
    push Not at hc
    exact hl (Multiplicative.toAdd.injective (Finsupp.ext hc))
  have a1 : j - n ∈ Ambient.sites 1 := by
    by_contra hc
    have := h3 _ hc
    rw [ambShift_conj_left, show n + (j - n) = j by omega] at this
    exact hj this
  have a2 : j - m ∈ Ambient.sites 1 := by
    by_contra hc
    have := h3' _ hc
    rw [ambShift_conj_left, show m + (j - m) = j by omega] at this
    exact hj this
  have := Finset.card_le_one.1 (by simp) _ a1 _ a2
  omega

/-- In `N × (ℤ/2 ≀ ℤ)` every `g ≠ 1` moves infinitely many cosets of the group generated by the
lamp at site `0`: the centralizer of that lamp has infinite index. -/
theorem ambient_moves (g : Ambient.G N) (hg : g ≠ 1) :
    {q : Ambient.G N ⧸ (ambientTower N).H 1 | g • q ≠ q}.Infinite := by
  classical
  have hg' : g⁻¹ ≠ 1 := inv_ne_one.mpr hg
  have key : ∀ n : ℤ, g • (QuotientGroup.mk (ambShift N n) : Ambient.G N ⧸ (ambientTower N).H 1)
      = QuotientGroup.mk (ambShift N n) ↔
      (ambShift N n)⁻¹ * g⁻¹ * ambShift N n ∈ (ambientTower N).H 1 := by
    intro n
    rw [MulAction.Quotient.smul_mk, smul_eq_mul, QuotientGroup.eq, mul_inv_rev]
  let n₀ : ℤ := if h : ∃ n, (ambShift N n)⁻¹ * g⁻¹ * ambShift N n ∈ (ambientTower N).H 1
    then h.choose else 0
  have hgood : ∀ n, n ≠ n₀ →
      (ambShift N n)⁻¹ * g⁻¹ * ambShift N n ∉ (ambientTower N).H 1 := by
    intro n hn hP
    have h : ∃ n, (ambShift N n)⁻¹ * g⁻¹ * ambShift N n ∈ (ambientTower N).H 1 := ⟨n, hP⟩
    apply hn
    have : n₀ = h.choose := by simp [n₀, h]
    rw [this]
    exact ambient_conj_unique N g⁻¹ hg' hP h.choose_spec
  refine Set.infinite_of_injective_forall_mem (α := ℕ)
    (f := fun k => (QuotientGroup.mk (ambShift N (n₀ + 1 + k)) :
      Ambient.G N ⧸ (ambientTower N).H 1)) ?_ ?_
  · intro k l hkl
    have := (ambient_mem_F N (QuotientGroup.eq.mp hkl)).2.1
    simp [ambShift] at this
    have h2 := congrArg Multiplicative.toAdd this
    simp at h2
    omega
  · intro k
    show ¬ (g • _ = _)
    rw [key]
    exact hgood _ (by omega)

/-- The orbits of `NP` on the cosets of that group are infinite. -/
theorem ambient_orbit_infinite (q : Ambient.G N ⧸ (ambientTower N).H 1) :
    (MulAction.orbit (ambientTower N).Λ q).Infinite := by
  classical
  have := (ambientTower N).H_finite 1
  have : Infinite Ambient.Lamps := inferInstanceAs (Infinite (ℤ →₀ ZMod 2))
  induction q using QuotientGroup.induction_on with
  | H γ =>
  let φ : Ambient.Lamps → Ambient.G N ⧸ (ambientTower N).H 1 :=
    fun c => QuotientGroup.mk (Ambient.includeLamps N c * γ)
  have hmem : ∀ c, Ambient.includeLamps N c ∈ (ambientTower N).Λ := fun c => by
    obtain ⟨n, hn⟩ := Ambient.lamps_exhaust N c
    exact (ambientTower N).H_le_Λ n hn
  have hsub : Set.range φ ⊆ MulAction.orbit (ambientTower N).Λ (QuotientGroup.mk γ) := by
    rintro _ ⟨c, rfl⟩
    exact ⟨⟨_, hmem c⟩, rfl⟩
  have hK : {d : Ambient.Lamps |
      γ⁻¹ * Ambient.includeLamps N d * γ ∈ (ambientTower N).H 1}.Finite := by
    have hinj : Function.Injective
        (fun d : Ambient.Lamps => γ⁻¹ * Ambient.includeLamps N d * γ) := by
      intro d e h
      exact Ambient.includeLamps_injective N (by simpa using h)
    exact (Set.toFinite ((ambientTower N).H 1 : Set (Ambient.G N))).preimage hinj.injOn
  have hfib : ∀ b, (φ ⁻¹' {b}).Finite := by
    intro b
    by_cases hb : ∃ c₀, φ c₀ = b
    · obtain ⟨c₀, rfl⟩ := hb
      refine (hK.image (fun d => c₀ * d)).subset ?_
      intro c hc
      refine ⟨c₀⁻¹ * c, ?_, by simp⟩
      have := QuotientGroup.eq.mp (Set.mem_singleton_iff.mp hc).symm
      show γ⁻¹ * Ambient.includeLamps N (c₀⁻¹ * c) * γ ∈ (ambientTower N).H 1
      convert this using 1
      simp [mul_assoc]
    · convert Set.finite_empty
      ext c
      simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_empty_iff_false, iff_false]
      exact fun h => hb ⟨c, h⟩
  intro hfin
  have := (hfin.subset hsub).preimage' (f := φ) (fun b _ => hfib b)
  rw [Set.preimage_range] at this
  exact Set.infinite_univ this

end Ambient

end Collapse
