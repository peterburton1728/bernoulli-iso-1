/-!
# Freeness and ergodicity of generalized Bernoulli shifts

A generalized Bernoulli shift `GB(F; M)`
with nontrivial base is essentially free if every `g ≠ 1` moves infinitely many cosets of `F`,
and a subgroup acts ergodically on it if all its orbits on `G ⧸ F` are infinite. Both hold in
`N × (ℤ/2 ≀ ℤ)` for `F` generated by the lamp at site `0`, which is `H 1` of the tower.
-/

@[expose] public section

set_option linter.unusedSectionVars false

noncomputable section

open MeasureTheory
open scoped symmDiff ENNReal Pointwise

namespace Collapse

section Coord

variable {ι : Type} {M : Type} [MeasurableSpace M]

/-- The σ-algebra generated by the coordinates in `S`. -/
def coordSigma (M : Type) [mM : MeasurableSpace M] (S : Set ι) : MeasurableSpace (ι → M) :=
  ⨆ j : S, MeasurableSpace.comap (fun x : ι → M => x j) mM

theorem coordSigma_le_iff {S : Set ι} {m : MeasurableSpace (ι → M)} :
    coordSigma M S ≤ m ↔ ∀ j ∈ S, MeasurableSpace.comap (fun x : ι → M => x j) ‹_› ≤ m := by
  unfold coordSigma
  rw [iSup_le_iff]
  exact ⟨fun h j hj => h ⟨j, hj⟩, fun h j => h j j.2⟩

theorem comap_le_coordSigma {S : Set ι} {j : ι} (hj : j ∈ S) :
    MeasurableSpace.comap (fun x : ι → M => x j) ‹_› ≤ coordSigma M S := by
  unfold coordSigma
  exact le_iSup (fun j : S => MeasurableSpace.comap (fun x : ι → M => x j)
    ‹MeasurableSpace M›) ⟨j, hj⟩

theorem coordSigma_mono {S T : Set ι} (h : S ⊆ T) : coordSigma M S ≤ coordSigma M T :=
  coordSigma_le_iff.2 fun _ hj => comap_le_coordSigma (h hj)

theorem coordSigma_le_pi (S : Set ι) : coordSigma M S ≤ MeasurableSpace.pi :=
  coordSigma_le_iff.2 fun j _ => (measurable_pi_apply j).comap_le

theorem measurable_coord {S : Set ι} {j : ι} (hj : j ∈ S) :
    Measurable[coordSigma M S] (fun x : ι → M => x j) :=
  Measurable.of_comap_le (comap_le_coordSigma hj)

theorem preimage_coordSigma {S S' : Set ι} (σ : ι → ι) (hσ : ∀ j ∈ S, σ j ∈ S')
    (B : Set (ι → M)) (hB : MeasurableSet[coordSigma M S] B) :
    MeasurableSet[coordSigma M S'] ((fun x : ι → M => fun j => x (σ j)) ⁻¹' B) := by
  have h : MeasurableSpace.comap (fun x : ι → M => fun j => x (σ j)) (coordSigma M S) ≤
      coordSigma M S' := by
    rw [MeasurableSpace.comap_le_iff_le_map, coordSigma_le_iff]
    intro j hj
    rw [← MeasurableSpace.comap_le_iff_le_map, MeasurableSpace.comap_comp]
    exact comap_le_coordSigma (hσ j hj)
  exact h _ ⟨B, hB, rfl⟩

theorem coordSigma_eq (S : Set ι) :
    coordSigma M S = ⨆ j ∈ S, MeasurableSpace.comap (fun x : ι → M => x j) ‹_› := by
  unfold coordSigma
  exact (iSup_subtype' (p := fun j => j ∈ S) (f := fun j _ =>
    MeasurableSpace.comap (fun x : ι → M => x j) ‹MeasurableSpace M›)).symm

theorem measure_inter_coord (mu : Measure M) [IsProbabilityMeasure mu] {S T : Set ι}
    (h : Disjoint S T) {A B : Set (ι → M)} (hA : MeasurableSet[coordSigma M S] A)
    (hB : MeasurableSet[coordSigma M T] B) :
    Measure.infinitePi (fun _ : ι => mu) (A ∩ B) =
      Measure.infinitePi (fun _ : ι => mu) A * Measure.infinitePi (fun _ : ι => mu) B :=
  (ProbabilityTheory.Indep_iff _ _ _).1
    (ProbabilityTheory.indep_iSup_of_disjoint (fun j => (measurable_pi_apply j).comap_le)
      (ProbabilityTheory.iIndepFun_infinitePi (P := fun _ : ι => mu) (X := fun _ (a : M) => a)
        (fun _ => measurable_id)) h) A B (by rw [← coordSigma_eq]; exact hA)
    (by rw [← coordSigma_eq]; exact hB)

theorem coord_isSetRing :
    IsSetRing {B : Set (ι → M) | ∃ S : Finset ι, MeasurableSet[coordSigma M ↑S] B} := by
  classical
  refine ⟨⟨∅, @MeasurableSet.empty _ (coordSigma M _)⟩, ?_, ?_⟩
  · rintro s t ⟨S, hS⟩ ⟨S', hS'⟩
    exact ⟨S ∪ S', MeasurableSet.union
      (coordSigma_mono (Finset.coe_subset.2 Finset.subset_union_left) _ hS)
      (coordSigma_mono (Finset.coe_subset.2 Finset.subset_union_right) _ hS')⟩
  · rintro s t ⟨S, hS⟩ ⟨S', hS'⟩
    exact ⟨S ∪ S', MeasurableSet.diff
      (coordSigma_mono (Finset.coe_subset.2 Finset.subset_union_left) _ hS)
      (coordSigma_mono (Finset.coe_subset.2 Finset.subset_union_right) _ hS')⟩

theorem pi_eq_generateFrom_coord :
    (MeasurableSpace.pi : MeasurableSpace (ι → M)) =
      MeasurableSpace.generateFrom
        {B : Set (ι → M) | ∃ S : Finset ι, MeasurableSet[coordSigma M ↑S] B} := by
  refine le_antisymm (iSup_le fun j => ?_)
    (MeasurableSpace.generateFrom_le fun B ⟨S, hS⟩ => coordSigma_le_pi _ _ hS)
  intro s hs
  apply MeasurableSpace.measurableSet_generateFrom
  exact ⟨{j}, comap_le_coordSigma (M := M) (S := ↑({j} : Finset ι)) (by simp) s hs⟩

end Coord

theorem abs_measureReal_sub_le {α : Type*} [MeasurableSpace α] (μ : Measure α)
    [IsFiniteMeasure μ] (s t : Set α) : |μ.real s - μ.real t| ≤ μ.real (s ∆ t) := by
  have h1 : ∀ u v : Set α, μ.real u ≤ μ.real v + μ.real (u ∆ v) := fun u v =>
    (measureReal_mono (fun x hx => by
      by_cases h : x ∈ v
      · exact Or.inl h
      · exact Or.inr (Set.mem_symmDiff.2 (Or.inl ⟨hx, h⟩)))).trans (measureReal_union_le _ _)
  rw [abs_sub_le_iff]
  constructor
  · linarith [h1 s t]
  · have := h1 t s
    rw [symmDiff_comm] at this
    linarith

theorem inter_symmDiff_inter_subset_union {α : Type*} (s t u v : Set α) :
    (s ∩ t) ∆ (u ∩ v) ⊆ (s ∆ u) ∪ (t ∆ v) := by
  intro x hx
  simp only [Set.mem_symmDiff, Set.mem_inter_iff, Set.mem_union] at hx ⊢
  tauto

/-- B. H. Neumann: if all orbits are infinite, a finite set can be moved off itself. -/
theorem exists_inv_smul_ne {Λ X : Type*} [Group Λ] [MulAction Λ X]
    (h : ∀ x : X, (MulAction.orbit Λ x).Infinite) (S : Finset X) :
    ∃ l : Λ, ∀ a ∈ S, ∀ b ∈ S, l⁻¹ • b ≠ a := by
  classical
  by_contra hcon
  push Not at hcon
  let g : X × X → Λ := fun p => if hp : ∃ l : Λ, l • p.2 = p.1 then hp.choose else 1
  have hcov : ⋃ p ∈ S ×ˢ S,
      g p • ((MulAction.stabilizer Λ p.2 : Subgroup Λ) : Set Λ) = Set.univ := by
    refine Set.eq_univ_of_forall fun l => ?_
    obtain ⟨a, ha, b, hb, hab⟩ := hcon l⁻¹
    rw [inv_inv] at hab
    refine Set.mem_iUnion₂.2 ⟨(a, b), Finset.mem_product.2 ⟨ha, hb⟩, ?_⟩
    have hex : ∃ l : Λ, l • b = a := ⟨l, hab⟩
    rw [mem_leftCoset_iff]
    simp only [g, hex, ↓reduceDIte]
    rw [SetLike.mem_coe, MulAction.mem_stabilizer_iff, mul_smul, hab, inv_smul_eq_iff,
      hex.choose_spec]
  obtain ⟨p, -, hp⟩ := Subgroup.exists_finiteIndex_of_leftCoset_cover hcov
  have := hp.index_ne_zero
  rw [MulAction.index_stabilizer] at this
  exact this (Set.Infinite.ncard (h p.2))

namespace PSystem

variable {G : Type} [Group G] [Countable G]

/-- Ergodicity passes to an invariant set of full measure. -/
theorem ergodic_restrict (S : PSystem G) (Λ : Subgroup G) [ErgodicSMul Λ S.X S.μ]
    (s : Set S.X) (hs : MeasurableSet s) (hinv : ∀ (g : G) (x : S.X), x ∈ s → g • x ∈ s)
    (hfull : S.μ sᶜ = 0) :
    ErgodicSMul Λ (S.restrict s hs hinv hfull).X (S.restrict s hs hinv hfull).μ := by
  set T := S.restrict s hs hinv hfull
  let v : T.X → S.X := fun x => @Subtype.val S.X (· ∈ s) x
  have hvinj : Function.Injective v := fun a b h => Subtype.val_injective h
  have hval : MeasurePreserving v T.μ S.μ :=
    BernoulliIso.measurePreserving_conullSubtype S.μ hs (ae_iff.2 hfull)
  have key : ∀ {P Q : Set S.X}, MeasurableSet P → MeasurableSet Q →
      (v ⁻¹' P =ᵐ[T.μ] v ⁻¹' Q ↔ P =ᵐ[S.μ] Q) := by
    intro P Q hP hQ
    rw [ae_eq_set, ae_eq_set, ← hval.measure_preimage (hP.diff hQ).nullMeasurableSet,
      ← hval.measure_preimage (hQ.diff hP).nullMeasurableSet]
    rfl
  have : SMulInvariantMeasure Λ T.X T.μ :=
    ⟨fun c t ht => (T.preserving c).measure_preimage ht.nullMeasurableSet⟩
  refine ⟨fun {t} ht h => ?_⟩
  set A : Set S.X := v '' t
  have hA : MeasurableSet A := (MeasurableEmbedding.subtype_coe hs).measurableSet_image.2 ht
  have hpre : v ⁻¹' A = t := Set.preimage_image_eq t hvinj
  have hAinv : ∀ g : Λ, (g • ·) ⁻¹' A =ᵐ[S.μ] A := by
    intro g
    have hm : MeasurableSet ((g • ·) ⁻¹' A : Set S.X) := hA.preimage (S.preserving g).measurable
    rw [← key hm hA]
    have : v ⁻¹' ((g • ·) ⁻¹' A : Set S.X) = ((g • ·) ⁻¹' t : Set T.X) := by
      refine Set.ext fun (x : T.X) => ?_
      show v (g • x) ∈ v '' t ↔ g • x ∈ t
      exact hvinj.mem_set_image
    rw [this, hpre]
    exact h g
  have hE := ErgodicSMul.aeconst_of_forall_preimage_smul_ae_eq hA hAinv
  rw [Filter.eventuallyEmptyOrUniv_iff'] at hE ⊢
  rw [← hpre]
  rcases hE with h1 | h1
  · exact Or.inl ((key hA MeasurableSet.empty).2 h1)
  · exact Or.inr ((key hA MeasurableSet.univ).2 h1)

instance free_ergodic (S : PSystem G) (h : S.EssFree) (Λ : Subgroup G)
    [ErgodicSMul Λ S.X S.μ] : ErgodicSMul Λ (S.free h).X (S.free h).μ :=
  S.ergodic_restrict Λ _ _ _ _

variable {M : Type} [MeasurableSpace M] [StandardBorelSpace M]

/-- If every `g ≠ 1` moves infinitely many cosets of `F` and the base is not a point mass,
then `GB(F; M)` is essentially free. -/
theorem gb_essFree (F : Subgroup G)
    (hF : ∀ g : G, g ≠ 1 → {q : G ⧸ F | g • q ≠ q}.Infinite) (mu : Measure M)
    [IsProbabilityMeasure mu] (hmu : ∀ a : M, mu ≠ Measure.dirac a) :
    (gb G F M mu).EssFree := by
  intro g hg
  set μ : Measure (G ⧸ F → M) := Measure.infinitePi (fun _ : G ⧸ F => mu) with hμdef
  set Fix : Set (gb G F M mu).X := {x | g • x = x}
  show μ Fix = 0
  set c : ℝ≥0∞ := (mu.prod mu) {p : M × M | p.1 = p.2} with hc
  have hD : MeasurableSet {p : M × M | p.1 = p.2} :=
    measurableSet_eq_fun measurable_fst measurable_snd
  have hc1 : c < 1 := by
    refine lt_of_le_of_ne prob_le_one fun h1 => ?_
    have h0 : (mu.prod mu) {p : M × M | p.1 = p.2}ᶜ = 0 := (prob_compl_eq_zero_iff hD).2 h1
    have hae : ∀ᵐ p ∂(mu.prod mu), p.1 = p.2 := ae_iff.2 h0
    obtain ⟨a, ha⟩ := (Measure.ae_ae_of_ae_prod hae).exists
    have ha0 : mu {b | ¬ a = b} = 0 := ae_iff.1 ha
    apply hmu a
    ext t ht
    rw [Measure.dirac_apply' a ht]
    by_cases hat : a ∈ t
    · rw [Set.indicator_of_mem hat, Pi.one_apply, ← prob_compl_eq_zero_iff ht]
      exact measure_mono_null (fun b hb (hab : a = b) => hb (by rw [← hab]; exact hat)) ha0
    · rw [Set.indicator_of_notMem hat]
      exact measure_mono_null (fun b hb (hab : a = b) => hat (by rw [hab]; exact hb)) ha0
  have key : ∀ n : ℕ, ∃ S : Finset (G ⧸ F), ∃ P : Set (G ⧸ F → M),
      MeasurableSet[coordSigma M (S : Set (G ⧸ F))] P ∧ Fix ⊆ P ∧ μ P ≤ c ^ n := by
    intro n
    induction n with
    | zero => exact ⟨∅, Set.univ, @MeasurableSet.univ _ (coordSigma M _), Set.subset_univ _, by simp⟩
    | succ n ih =>
      classical
      obtain ⟨S, P, hP, hFP, hPn⟩ := ih
      obtain ⟨q, hq, hqS⟩ := (hF g hg).exists_notMem_finset (S ∪ S.image (g • ·))
      have hq1 : q ∉ S := fun h => hqS (Finset.mem_union_left _ h)
      have hq2 : g⁻¹ • q ∉ S := fun h =>
        hqS (Finset.mem_union_right _ (Finset.mem_image.2 ⟨_, h, smul_inv_smul g q⟩))
      have hne : g⁻¹ • q ≠ q := fun h => hq (by rw [eq_comm, ← inv_smul_eq_iff]; exact h)
      set E : Set (G ⧸ F → M) := {x | x (g⁻¹ • q) = x q}
      have hE : MeasurableSet[coordSigma M ({g⁻¹ • q, q} : Set (G ⧸ F))] E :=
        measurableSet_eq_fun (measurable_coord (by simp)) (measurable_coord (by simp))
      have hdisj : Disjoint (S : Set (G ⧸ F)) {g⁻¹ • q, q} := by
        rw [Set.disjoint_right]
        rintro r (rfl | rfl) <;> assumption
      have hEc : μ E = c := by
        have := Measure.infinitePi_map_eval_prod (P := fun _ : G ⧸ F => mu) hne
        rw [hc, ← this, Measure.map_apply (by fun_prop) hD]
        rfl
      refine ⟨insert q (insert (g⁻¹ • q) S), P ∩ E, ?_, ?_, ?_⟩
      · exact MeasurableSet.inter
          (coordSigma_mono (fun r hr => by simp [Finset.mem_coe.1 hr]) _ hP)
          (coordSigma_mono (fun r hr => by
            simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hr
            rcases hr with rfl | rfl <;> simp) _ hE)
      · intro x hx
        exact ⟨hFP hx, congrFun hx q⟩
      · rw [measure_inter_coord mu hdisj hP hE, hEc, pow_succ]
        gcongr
  refine le_antisymm (ge_of_tendsto' (ENNReal.tendsto_pow_atTop_nhds_zero_of_lt_one hc1)
    fun n => ?_) (by simp)
  obtain ⟨S, P, -, hFP, hPn⟩ := key n
  exact (measure_mono hFP).trans hPn

/-- If all orbits of `Λ` on `G ⧸ F` are infinite, then `Λ` acts ergodically on `GB(F; M)`. -/
theorem gb_ergodic (F Λ : Subgroup G) (hΛ : ∀ q : G ⧸ F, (MulAction.orbit Λ q).Infinite)
    (mu : Measure M) [IsProbabilityMeasure mu] :
    ErgodicSMul Λ (gb G F M mu).X (gb G F M mu).μ := by
  classical
  have : SMulInvariantMeasure Λ (gb G F M mu).X (gb G F M mu).μ :=
    ⟨fun l t ht => ((gb G F M mu).preserving l).measure_preimage ht.nullMeasurableSet⟩
  refine ⟨fun {A} hA hinv => ?_⟩
  set μ : Measure (G ⧸ F → M) := Measure.infinitePi (fun _ : G ⧸ F => mu) with hμ
  have hA' : MeasurableSet (α := G ⧸ F → M) A := hA
  have hpres : ∀ l : Λ, MeasurePreserving
      (fun x : G ⧸ F → M => fun q => x ((l : G)⁻¹ • q)) μ μ :=
    fun l => (gb G F M mu).preserving l
  have hinv' : ∀ l : Λ,
      (fun x : G ⧸ F → M => fun q => x ((l : G)⁻¹ • q)) ⁻¹' A =ᵐ[μ] A := hinv
  set a := μ.real A with ha
  have ha0 : 0 ≤ a := measureReal_nonneg
  have ha1 : a ≤ 1 := measureReal_le_one
  have key : ∀ ε : ℝ, 0 < ε → |a - a * a| ≤ 4 * ε := by
    intro ε hε
    obtain ⟨B, ⟨S, hB⟩, hBA⟩ := exists_measure_symmDiff_lt_of_generateFrom_isSetRing (μ := μ)
      coord_isSetRing ⟨{Set.univ}, Set.countable_singleton _,
        by simp, by simp⟩
      pi_eq_generateFrom_coord hA' (ENNReal.ofReal_pos.2 hε)
    obtain ⟨l, hl⟩ := exists_inv_smul_ne (fun q => hΛ q) S
    set σ : G ⧸ F → G ⧸ F := fun q => (l : G)⁻¹ • q
    set TB := (fun x : G ⧸ F → M => fun q => x (σ q)) ⁻¹' B
    set TA := (fun x : G ⧸ F → M => fun q => x (σ q)) ⁻¹' A
    have hTB : MeasurableSet[coordSigma M ↑(S.image σ)] TB :=
      preimage_coordSigma σ (fun j hj => by
        simp only [Finset.coe_image]; exact Set.mem_image_of_mem σ hj) B hB
    have hdisj : Disjoint (S : Set (G ⧸ F)) ↑(S.image σ) := by
      rw [Set.disjoint_left]
      intro a' ha' hb'
      obtain ⟨b', hb'S, hb'eq⟩ := Finset.mem_image.1 hb'
      exact hl a' ha' b' hb'S hb'eq
    have hBm : MeasurableSet B := coordSigma_le_pi _ _ hB
    have hind : μ (B ∩ TB) = μ B * μ TB := measure_inter_coord mu hdisj hB hTB
    have hTBm : μ TB = μ B := (hpres l).measure_preimage hBm.nullMeasurableSet
    have hd : μ.real (B ∆ A) ≤ ε := ENNReal.toReal_le_of_le_ofReal hε.le hBA.le
    set b := μ.real B with hbdef
    have hb0 : 0 ≤ b := measureReal_nonneg
    have hb1 : b ≤ 1 := measureReal_le_one
    have h1 : |b - a| ≤ ε := (abs_measureReal_sub_le μ B A).trans hd
    have h2 : μ.real (B ∩ TB) = b * b := by
      simp only [Measure.real, hind, hTBm, ENNReal.toReal_mul]
      rfl
    have h3 : μ.real (A ∩ TA) = a := by
      have : μ (A ∩ TA) = μ A :=
        (measure_congr (ae_eq_set_inter (ae_eq_refl A) (hinv' l))).trans
          (congrArg μ (Set.inter_self A))
      show (μ (A ∩ TA)).toReal = (μ A).toReal
      rw [this]
    have h4 : μ.real (TB ∆ TA) = μ.real (B ∆ A) := by
      simp only [Measure.real]
      rw [← (hpres l).measure_preimage (hBm.symmDiff hA').nullMeasurableSet]
      rfl
    have h5 : |μ.real (B ∩ TB) - μ.real (A ∩ TA)| ≤ 2 * ε := by
      refine (abs_measureReal_sub_le μ _ _).trans ?_
      calc μ.real ((B ∩ TB) ∆ (A ∩ TA)) ≤ μ.real ((B ∆ A) ∪ (TB ∆ TA)) :=
            measureReal_mono (inter_symmDiff_inter_subset_union B TB A TA)
        _ ≤ μ.real (B ∆ A) + μ.real (TB ∆ TA) := measureReal_union_le _ _
        _ ≤ 2 * ε := by rw [h4]; linarith
    rw [h2, h3] at h5
    rw [abs_le] at h1 h5 ⊢
    obtain ⟨h1a, h1b⟩ := h1
    obtain ⟨h5a, h5b⟩ := h5
    constructor
    · nlinarith [mul_nonneg (by linarith : 0 ≤ ε + (b - a)) (by linarith : 0 ≤ b + a),
        mul_nonneg hε.le (by linarith : 0 ≤ 2 - (b + a))]
    · nlinarith [mul_nonneg (by linarith : 0 ≤ ε - (b - a)) (by linarith : 0 ≤ b + a),
        mul_nonneg hε.le (by linarith : 0 ≤ 2 - (b + a))]
  have haa : a * (1 - a) = 0 := by
    by_contra hne
    have hpos : 0 < |a - a * a| := abs_pos.2 (fun h => hne (by linear_combination h))
    have := key (|a - a * a| / 8) (by positivity)
    linarith
  rw [Filter.eventuallyEmptyOrUniv_iff]
  rcases mul_eq_zero.1 haa with h | h
  · right
    have h0 : μ A = 0 := (measureReal_eq_zero_iff).1 h
    show ∀ᵐ x ∂μ, x ∉ A
    exact ae_iff.2 (measure_mono_null (fun x hx => not_not.1 hx) h0)
  · left
    have h1 : μ A = 1 := (ENNReal.toReal_eq_one_iff _).1 (by show a = 1; linarith)
    show ∀ᵐ x ∂μ, x ∈ A
    exact ae_iff.2 ((prob_compl_eq_zero_iff hA').2 h1)

end PSystem

end Collapse
