module

public import Collapse.RelativeCollapse
public import Collapse.RestrictScalars
public import Collapse.GBLemmas
public import Collapse.AmbientLemmas
public import Collapse.Pairing
public import CertifiedInput

/-!
# All Bernoulli shifts of `N × (ℤ/2 ≀ ℤ)` are isomorphic

The proof of the main theorem by the pairing argument, Steps 1--3, for the group
`G₀ = N × (ℤ/2 ≀ ℤ)` of the registered entry and the pinned input restricted to `ZMod 2`.
-/

@[expose] public section

set_option linter.unusedSectionVars false

noncomputable section

open MeasureTheory

namespace Collapse

open BernoulliIso PSystem

/-- The group of the registered entry. -/
abbrev G₀ : Type := Ambient.G Upstream.N

/-- Its tower of lamp subgroups. -/
abbrev τ₀ : TowerSetting Upstream.N G₀ := ambientTower Upstream.N

/-- The subgroup of order 2 generated by the lamp at site `0`. -/
abbrev F₀ : Subgroup G₀ := τ₀.H 1

instance : Algebra (ZMod 2) Upstream.K := ZMod.algebra _ 2

instance : NeZero (Module.finrank (ZMod 2) Upstream.K) :=
  haveI : Module.Finite (ZMod 2) Upstream.K := Module.Finite.of_finite
  ⟨Module.finrank_pos.ne'⟩

/-- The pinned input, restricted to the prime field (restriction of scalars). -/
def input₂ :
    AlgebraicInput (ZMod 2) Upstream.N (Upstream.I × Fin (Module.finrank (ZMod 2) Upstream.K))
      (Upstream.V × Fin (Module.finrank (ZMod 2) Upstream.K)) :=
  restrictScalars (Module.finBasis (ZMod 2) Upstream.K) Upstream.algebraicInput

/-- The Bernoulli shift of `G₀` with base `C = (ℤ/2)^ℕ`. -/
abbrev C₀ : PSystem G₀ := bernoulli G₀ (ℕ → ZMod 2) (cantorK (ZMod 2))

theorem cantorK_singleton (x : ℕ → ZMod 2) : cantorK (ZMod 2) {x} = 0 := by
  have h1 : ∀ i, uniformK (ZMod 2) {x i} = 2⁻¹ := by
    intro i
    simp [uniformK, Measure.uniformOfFinset_apply_singleton]
  rw [cantorK, Measure.infinitePi_singleton]
  simp only [h1]
  rw [ENNReal.tprod_eq_iInf_prod (fun _ => by norm_num)]
  refine le_antisymm ?_ (by simp)
  refine ge_of_tendsto' (ENNReal.tendsto_pow_atTop_nhds_zero_of_lt_one
    (by norm_num : (2⁻¹ : ENNReal) < 1)) (fun n => ?_)
  exact iInf_le_of_le (Finset.range n) (by simp)

theorem lebI_ne_dirac (a : ℝ) : lebI ≠ Measure.dirac a := by
  intro h
  have := lebI_singleton a
  rw [h] at this
  simp at this

/-- Step 1: `Ber(L) ≅ GB(F; L⁽²⁾) × Ber(C)`. -/
theorem step1 (lam : Measure ℝ) [IsProbabilityMeasure lam] (hlam : ∀ a, lam ≠ Measure.dirac a) :
    (bernoulli G₀ ℝ lam).Iso ((gb G₀ F₀ (ℝ × ℝ) (pairLaw lam)).prod C₀) := by
  have hess : (gb G₀ F₀ (ℝ × ℝ) (pairLaw lam)).EssFree :=
    gb_essFree F₀ (ambient_moves Upstream.N) (pairLaw lam) (pairLaw_ne_dirac lam hlam)
  obtain ⟨A, hA, hpos, hiso⟩ := pairing F₀ (ambient_H_one_card Upstream.N) lam hlam hess
  have : ErgodicSMul τ₀.Λ (gb G₀ F₀ (ℝ × ℝ) (pairLaw lam)).X
      (gb G₀ F₀ (ℝ × ℝ) (pairLaw lam)).μ :=
    gb_ergodic F₀ τ₀.Λ (ambient_orbit_infinite Upstream.N) (pairLaw lam)
  have h2 := bundle_iso_prod τ₀ input₂ ((gb G₀ F₀ (ℝ × ℝ) (pairLaw lam)).free hess) A hA hpos
  exact hiso.trans (h2.trans (Iso.prod_congr (free_iso _ hess) (Iso.refl _)))

/-- Step 2: `Ber(C) ≅ GB(F; C) × Ber(C)`. -/
theorem step2 : C₀.Iso ((gb G₀ F₀ (ℕ → ZMod 2) (cantorK (ZMod 2))).prod C₀) := by
  have h1 := step1 lebI lebI_ne_dirac
  have a1 : AEIso lebI (cantorK (ZMod 2)) :=
    aeIso_of_noAtoms _ _ lebI_singleton cantorK_singleton
  have a2 : AEIso (pairLaw lebI) (cantorK (ZMod 2)) :=
    aeIso_of_noAtoms _ _ (pairLaw_singleton lebI lebI_singleton) cantorK_singleton
  exact (bernoulli_iso_of_aeIso a1).symm.trans
    (h1.trans (Iso.prod_congr (gb_iso_of_aeIso F₀ a2) (Iso.refl _)))

/-- Step 3, for a base on `ℝ`: `Ber(L) ≅ Ber(C)`. -/
theorem step3 (lam : Measure ℝ) [IsProbabilityMeasure lam] (hlam : ∀ a, lam ≠ Measure.dirac a) :
    (bernoulli G₀ ℝ lam).Iso C₀ := by
  have h1 := step1 lam hlam
  have h2 := step2
  have a : AEIso ((pairLaw lam).prod (cantorK (ZMod 2))) (cantorK (ZMod 2)) :=
    aeIso_of_noAtoms _ _ (prod_singleton_of_right _ _ cantorK_singleton) cantorK_singleton
  exact h1.trans ((Iso.prod_congr (Iso.refl _) h2).trans ((prod_assoc _ _ _).symm.trans
    ((Iso.prod_congr (gb_prod F₀) (Iso.refl _)).trans
      ((Iso.prod_congr (gb_iso_of_aeIso F₀ a) (Iso.refl _)).trans h2.symm))))

theorem map_embeddingReal_ne_dirac {L : Type} [MeasurableSpace L] [StandardBorelSpace L]
    (lam : Measure L) [IsProbabilityMeasure lam] (hlam : ∀ a, lam ≠ Measure.dirac a) (a : ℝ) :
    lam.map (embeddingReal L) ≠ Measure.dirac a := by
  intro h
  have he := measurableEmbedding_embeddingReal L
  have h1 : lam (embeddingReal L ⁻¹' {a}) = 1 := by
    rw [← Measure.map_apply he.measurable (measurableSet_singleton a), h]
    simp
  obtain ⟨b, hb⟩ : (embeddingReal L ⁻¹' {a}).Nonempty :=
    nonempty_of_measure_ne_zero (by rw [h1]; simp)
  have hpre : embeddingReal L ⁻¹' {a} = {b} := by
    ext y
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    constructor
    · intro hy
      exact he.injective (hy.trans hb.symm)
    · rintro rfl
      exact hb
  rw [hpre] at h1
  have hc : lam {b}ᶜ = 0 := (prob_compl_eq_zero_iff (measurableSet_singleton b)).2 h1
  apply hlam b
  ext s hs
  rw [Measure.dirac_apply' _ hs]
  by_cases hbs : b ∈ s
  · rw [Set.indicator_of_mem hbs]
    refine le_antisymm prob_le_one ?_
    calc (1 : ENNReal) = lam {b} := h1.symm
      _ ≤ lam s := measure_mono (Set.singleton_subset_iff.2 hbs)
  · rw [Set.indicator_of_notMem hbs]
    refine measure_mono_null (fun y hy => ?_) hc
    rintro rfl
    exact hbs hy

/-- `Ber(L) ≅ Ber(C)` for every standard probability space `L` which is not a point mass. -/
theorem bernoulli_iso_C₀ (L : Type) [MeasurableSpace L] [StandardBorelSpace L] (lam : Measure L)
    [IsProbabilityMeasure lam] (hlam : ∀ a, lam ≠ Measure.dirac a) :
    (bernoulli G₀ L lam).Iso C₀ := by
  have : IsProbabilityMeasure (lam.map (embeddingReal L)) := by
    constructor
    rw [Measure.map_apply (measurableEmbedding_embeddingReal L).measurable MeasurableSet.univ]
    simp
  have e : AEIso lam (lam.map (embeddingReal L)) :=
    AEIso.of_measurableEmbedding _ (measurableEmbedding_embeddingReal L)
  exact (bernoulli_iso_of_aeIso e).trans (step3 _ (map_embeddingReal_ne_dirac lam hlam))

/-- **All Bernoulli shifts of `G₀` with nontrivial standard bases are isomorphic.** -/
theorem all_bernoulli_iso (L L' : Type) [MeasurableSpace L] [StandardBorelSpace L]
    [MeasurableSpace L'] [StandardBorelSpace L'] (lam : Measure L) (lam' : Measure L')
    [IsProbabilityMeasure lam] [IsProbabilityMeasure lam'] (hlam : ∀ a, lam ≠ Measure.dirac a)
    (hlam' : ∀ a, lam' ≠ Measure.dirac a) :
    (bernoulli G₀ L lam).Iso (bernoulli G₀ L' lam') :=
  (bernoulli_iso_C₀ L lam hlam).trans (bernoulli_iso_C₀ L' lam' hlam').symm

end Collapse
