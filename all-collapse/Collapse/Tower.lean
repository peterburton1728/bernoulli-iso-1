module

public import Collapse.Kernel
public import BernoulliIso.AmbientGroup
public import Mathlib.Algebra.Group.Subgroup.Actions
public import Mathlib.GroupTheory.NoncommCoprod

/-!
# The group-theoretic setting of the collapse

The setting: a group `G` with a copy of `N` and an increasing sequence of
finite subgroups `H k` which commute with `N` and meet it trivially. Here every `H k` has order
`2 ^ k`, as in the group `N × (ℤ/2 ≀ ℤ)` of the registered entry.
-/

@[expose] public section

set_option linter.unusedSectionVars false

namespace Collapse

/-- The setting: `ι` embeds `N` in `G`; `H k` are finite subgroups of order `2 ^ k`, increasing,
commuting with `ι N` and meeting it trivially. `P` denotes the union of the `H k`. -/
structure TowerSetting (N G : Type) [Group N] [Group G] where
  ι : N →* G
  ι_injective : Function.Injective ι
  H : ℕ → Subgroup G
  H_zero : H 0 = ⊥
  H_mono : Monotone H
  H_finite : ∀ k, Finite (H k)
  H_card : ∀ k, Nat.card (H k) = 2 ^ k
  H_comm : ∀ k, ∀ h ∈ H k, ∀ n : N, Commute (ι n) h
  H_disjoint : ∀ k, Disjoint (H k) ι.range

namespace TowerSetting

variable {N G : Type} [Group N] [Group G] (τ : TowerSetting N G)

/-- The subgroup `NP`: generated by `ι N` and all `H k`. -/
def Λ : Subgroup G := τ.ι.range ⊔ ⨆ k, τ.H k

/-- The finite subgroup `J H_k` for a subgroup `J` of `N`. -/
def JH (J : Subgroup N) (k : ℕ) : Subgroup G := J.map τ.ι ⊔ τ.H k

theorem H_le_Λ (k : ℕ) : τ.H k ≤ τ.Λ :=
  (le_iSup τ.H k).trans le_sup_right

theorem range_le_Λ : τ.ι.range ≤ τ.Λ := le_sup_left

theorem JH_le_Λ (J : Subgroup N) (k : ℕ) : τ.JH J k ≤ τ.Λ :=
  sup_le ((Subgroup.map_le_range τ.ι J).trans τ.range_le_Λ) (τ.H_le_Λ k)

theorem H_le_JH (J : Subgroup N) (k : ℕ) : τ.H k ≤ τ.JH J k := le_sup_right

/-- The multiplication map `J × H k → G`. -/
noncomputable def JHmul (J : Subgroup N) (k : ℕ) : J × τ.H k →* G :=
  (τ.ι.comp J.subtype).noncommCoprod (τ.H k).subtype
    (fun a h => show Commute (τ.ι a.1) h.1 from τ.H_comm k h.1 h.2 a.1)

theorem JHmul_range (J : Subgroup N) (k : ℕ) : (τ.JHmul J k).range = τ.JH J k := by
  refine (MonoidHom.noncommCoprod_range _ _ _).trans ?_
  rw [MonoidHom.range_comp, Subgroup.range_subtype,
    Subgroup.range_subtype, JH]

theorem JHmul_injective (J : Subgroup N) (k : ℕ) : Function.Injective (τ.JHmul J k) := by
  refine (MonoidHom.noncommCoprod_injective _ _ _).mpr ⟨τ.ι_injective.comp Subtype.val_injective, Subtype.val_injective, ?_⟩
  rw [MonoidHom.range_comp, Subgroup.range_subtype, Subgroup.range_subtype]
  exact (τ.H_disjoint k).symm.mono_left (Subgroup.map_le_range τ.ι J)

theorem JH_finite (J : Subgroup N) [Finite J] (k : ℕ) : Finite (τ.JH J k) := by
  have := τ.H_finite k
  rw [← τ.JHmul_range J k]
  exact Finite.of_equiv _ (MonoidHom.ofInjective (τ.JHmul_injective J k)).toEquiv

theorem JH_card (J : Subgroup N) [Finite J] (k : ℕ) :
    Nat.card (τ.JH J k) = Nat.card J * 2 ^ k := by
  rw [← τ.JHmul_range J k, ← τ.H_card k, ← Nat.card_prod,
    Nat.card_congr (MonoidHom.ofInjective (τ.JHmul_injective J k)).toEquiv.symm]

end TowerSetting

/-- The setting of the registered entry: `G = N × (ℤ/2 ≀ ℤ)` with the lamp subgroups. -/
noncomputable def ambientTower (N : Type) [Group N] : TowerSetting N (BernoulliIso.Ambient.G N) where
  ι := BernoulliIso.Ambient.includeN N
  ι_injective := BernoulliIso.Ambient.includeN_injective N
  H := BernoulliIso.Ambient.Hseq N
  H_zero := BernoulliIso.Ambient.Hseq_zero_eq_bot N
  H_mono := BernoulliIso.Ambient.Hseq_mono N
  H_finite := fun k => inferInstance
  H_card := BernoulliIso.Ambient.Hseq_card N
  H_comm := fun k h hh n => BernoulliIso.Ambient.commute_H N _ n ⟨h, hh⟩
  H_disjoint := fun k => by
    rw [MonoidHom.range_eq_map]
    exact BernoulliIso.Ambient.H_disjoint_N N _ ⊤

/-- A free Borel action of `G` restricts to a free Borel action of every subgroup. -/
instance BorelFree.subgroup {G X : Type} [Group G] [MulAction G X] [MeasurableSpace X]
    [BorelFree G X] (S : Subgroup G) : BorelFree S X where
  countable := by
    have := BorelFree.countable (Λ := G) (X := X)
    infer_instance
  measurable_smul s := BorelFree.measurable_smul (s : G)
  free s x h := Subtype.ext (BorelFree.free (s : G) x h)

end Collapse
