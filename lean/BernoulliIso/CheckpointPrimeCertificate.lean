    sModNatTR.go modulus 64  =
       := rfl

private theorem checkpoint_001 :
    sModNatTR.go modulus 128 4 =
       :=
  (go_add modulus 64 64 4).trans
    ((congrArg (sModNatTR.go modulus 64) checkpoint_000).trans block_001)

